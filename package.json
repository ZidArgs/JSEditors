{
  "name": "jseditors",
  "author": "Denis Peters (ZidArgs)",
  "version": "0.1.14",
  "description": "JavaScript based editors",
  "type": "module",
  "license": "UNLICENSED",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/zidargs/jseditors.git"
  },
  "homepage": "https://bitbucket.org/zidargs/jseditors/src",
  "dependencies": {
    "emcjs": "git+https://bitbucket.org/zidargs/emcjs.git#0.9.11"
  },
  "devDependencies": {
    "@babel/core": "^7.16.10",
    "@babel/eslint-parser": "^7.16.5",
    "@babel/plugin-syntax-import-assertions": "^7.17.12",
    "@babel/plugin-syntax-top-level-await": "^7.14.5",
    "electron": "^25.0.1",
    "eslint": "^8.0.0",
    "gulp": "^4.0.2",
    "gulp-newer": "^1.4.0"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "lint": "yarn eslint .",
    "lintfix": "yarn eslint --fix .",
    "build": "gulp build",
    "edit": "gulp build -rebuild && electron ./editor --no-sandbox > ./editor/info.log 2>&1",
    "serve": "serve ./editor/web -p 15000"
  }
}