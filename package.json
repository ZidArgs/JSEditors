{
  "name": "jseditors",
  "author": "Denis Weiß (ZidArgs)",
  "version": "0.4.2",
  "description": "JavaScript based editors",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/zidargs/jseditors.git"
  },
  "homepage": "https://bitbucket.org/zidargs/jseditors/src",
  "dependencies": {
    "@emcjs/core": "https://github.com/ZidArgs/emcJS-Core.git/#1.0.7",
    "@emcjs/fe": "https://github.com/ZidArgs/emcJS-FE.git/#0.1.14",
    "jswebservice": "https://github.com/ZidArgs/JSWebService.git/#3.1.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.4",
    "@babel/plugin-syntax-import-assertions": "^7.27.1",
    "@babel/plugin-syntax-top-level-await": "^7.14.5",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@zidargs/buildtools": "https://github.com/ZidArgs/buildtools.git/#1.1.1",
    "electron": "^25.0.1",
    "eslint": "^9.35.0",
    "gulp": "^4.0.2",
    "gulp-changed": "^5.0.4"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "lint": "yarn eslint .",
    "lintfix": "yarn eslint --fix .",
    "build": "gulp build",
    "edit": "gulp build -rebuild && electron ./editor --no-sandbox > ./editor/info.log 2>&1",
    "serve": "gulp build -rebuild && node server.js"
  }
}
