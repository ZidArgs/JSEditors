{
  "name": "jseditors",
  "author": "Denis Weiß (ZidArgs)",
  "version": "0.2.1",
  "description": "JavaScript based editors",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/zidargs/jseditors.git"
  },
  "homepage": "https://bitbucket.org/zidargs/jseditors/src",
  "dependencies": {
    "emcjs": "git+https://bitbucket.org/zidargs/emcjs.git#0.17.0",
    "jswebservice": "git+https://bitbucket.org/zidargs/jswebservice.git/#2.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.16.10",
    "@babel/eslint-parser": "^7.16.5",
    "@babel/plugin-syntax-import-assertions": "^7.17.12",
    "@babel/plugin-syntax-top-level-await": "^7.14.5",
    "electron": "^25.0.1",
    "eslint": "^8.0.0",
    "gulp": "^4.0.2",
    "gulp-newer": "^1.4.0"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "lint": "yarn eslint .",
    "lintfix": "yarn eslint --fix .",
    "build": "gulp build",
    "edit": "gulp build -rebuild && electron ./editor --no-sandbox > ./editor/info.log 2>&1",
    "serve": "gulp build -rebuild && node server.js"
  }
}
